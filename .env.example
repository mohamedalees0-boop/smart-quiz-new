# Copy this file to .env for running on your own computer
PORT=3000

# Postgres connection string (from Neon). On Vercel this is added automatically.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# REQUIRED in production: any long random string
JWT_SECRET=change-this-to-a-long-random-string

# The user who registers with this email automatically becomes ADMIN
ADMIN_EMAIL=you@example.com

# OPTIONAL: enables "AI generate questions" in the admin panel
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
